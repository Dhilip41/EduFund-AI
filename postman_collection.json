{
  "info": {
    "name": "AI Scholarship & Loan Recommendation System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test Student\",\n  \"email\": \"student@example.com\",\n  \"password\": \"password123\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"userId\": \"<userId>\",\n  \"otp\": \"123456\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/verify-otp", "host": ["{{baseUrl}}"], "path": ["auth", "verify-otp"] }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@scholarloan.com\",\n  \"password\": \"Admin@123\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/users/profile", "host": ["{{baseUrl}}"], "path": ["users", "profile"] }
          }
        }
      ]
    },
    {
      "name": "Scholarships",
      "item": [
        {
          "name": "Get All Scholarships",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/scholarships", "host": ["{{baseUrl}}"], "path": ["scholarships"] }
          }
        },
        {
          "name": "AI Predict Scholarships",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{baseUrl}}/prediction/predictScholarship", "host": ["{{baseUrl}}"], "path": ["prediction", "predictScholarship"] }
          }
        }
      ]
    },
    {
      "name": "Loans",
      "item": [
        {
          "name": "Get All Banks",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/loans/banks", "host": ["{{baseUrl}}"], "path": ["loans", "banks"] }
          }
        },
        {
          "name": "AI Predict Loan",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"collegeFee\": 500000,\n  \"tuitionFee\": 300000,\n  \"course\": \"B.Tech\",\n  \"collegeType\": \"Private\",\n  \"country\": \"India\",\n  \"loanAmountRequired\": 600000,\n  \"repaymentYears\": 7,\n  \"income\": 400000,\n  \"existingLoan\": 0,\n  \"creditScore\": 720,\n  \"coApplicantIncome\": 200000\n}"
            },
            "url": { "raw": "{{baseUrl}}/prediction/predictLoan", "host": ["{{baseUrl}}"], "path": ["prediction", "predictLoan"] }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Analytics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/admin/analytics", "host": ["{{baseUrl}}"], "path": ["admin", "analytics"] }
          }
        }
      ]
    }
  ]
}
